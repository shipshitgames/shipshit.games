{
  "name": "@shipshitgames/ressources",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "ressources": "./src/cli.ts",
    "research": "./src/cli.ts"
  },
  "scripts": {
    "ci": "bun run typecheck && bun src/cli.ts validate && bun test",
    "rules": "bun src/cli.ts distill",
    "distill": "bun src/cli.ts distill",
    "list": "bun src/cli.ts sources",
    "validate": "bun src/cli.ts validate",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --removeRange && bun install"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  }
}
