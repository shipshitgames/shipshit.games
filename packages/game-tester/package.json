{
  "name": "@shipshitgames/game-tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic Playwright browser-QA harness for canvas/WebGL games: wait for ready, drive input, screenshot, detect blank renders, emit an agent-readable report.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": { "game-tester": "./src/cli.ts" },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install chromium",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --removeRange && bun install"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  }
}
