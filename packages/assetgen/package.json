{
  "name": "@shipshitgames/assetgen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "assetgen": "./src/cli.ts"
  },
  "exports": {
    "./style": {
      "types": "./src/style.generated.ts",
      "default": "./src/style.generated.ts"
    },
    "./sprite-prompt": {
      "types": "./src/sprite-prompt.ts",
      "default": "./src/sprite-prompt.ts"
    },
    "./sprites": {
      "types": "./src/sprites.ts",
      "default": "./src/sprites.ts"
    },
    "./replicate": {
      "types": "./src/replicate.ts",
      "default": "./src/replicate.ts"
    },
    "./asset-qa": {
      "types": "./src/asset-qa/index.ts",
      "default": "./src/asset-qa/index.ts"
    },
    "./asset-qa.schema.json": "./asset-qa.schema.json",
    "./src/*": "./src/*"
  },
  "scripts": {
    "gen": "bun src/cli.ts",
    "matrix": "bun src/cli.ts matrix",
    "tokens": "bun src/cli.ts tokens",
    "lint": "bun src/cli.ts check-design --root ../..",
    "check:tokens": "bun src/cli.ts tokens --check --repo-only",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "e2e": "bun test e2e",
    "typecheck": "tsc --noEmit",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --removeRange && bun install"
  },
  "dependencies": {
    "@gltf-transform/core": "4.4.0",
    "@gltf-transform/extensions": "4.4.0",
    "@gltf-transform/functions": "4.4.0",
    "draco3dgltf": "1.5.7",
    "meshoptimizer": "1.2.0",
    "node-pty": "1.1.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "ajv": "8.20.0",
    "typescript": "6.0.3"
  }
}
