{
  "name": "@shipshitgames/engine",
  "version": "0.3.0",
  "description": "Ship Shit Games' open-source embodied 3D game engine — the Game/Context/Systems spine, swappable camera rig, embodied movement + collision + world bounds, the agent/steering + spawn + wave-director seams, the generic HUD snapshot shell, input bindings, and replicated presence. One MIT npm package serving every studio title.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./net/server": {
      "types": "./src/net/server.ts",
      "default": "./src/net/server.ts"
    },
    "./physics": {
      "types": "./src/physics/index.ts",
      "default": "./src/physics/index.ts"
    },
    "./gym/file": {
      "types": "./src/gym/file-persistence.ts",
      "default": "./src/gym/file-persistence.ts"
    },
    "./assets-manifest.schema.json": "./src/assets/assets-manifest.schema.json"
  },
  "files": [
    "CANONICAL-ENGINE.md",
    "ENGINE-EXTRACTION-BOUNDARY.md",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test src ENGINE-EXTRACTION-BOUNDARY.test.ts CANONICAL-ENGINE.test.ts",
    "test:coverage": "bun test src --coverage",
    "e2e": "bun test tests/e2e",
    "smoke:package": "bun tests/package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --removeRange && bun install"
  },
  "peerDependencies": {
    "partykit": "0.0.115",
    "three": ">=0.169.0 <0.185.0"
  },
  "peerDependenciesMeta": {
    "partykit": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@types/howler": "^2.2.12",
    "howler": "^2.2.4",
    "partysocket": "^1.1.19"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@types/bun": "1.3.14",
    "@types/howler": "^2.2.12",
    "@types/three": "0.184.1",
    "ajv": "^8.20.0",
    "howler": "^2.2.4",
    "partykit": "0.0.115",
    "partysocket": "^1.1.19",
    "three": "0.184.0",
    "typescript": "6.0.3"
  },
  "keywords": [
    "game-engine",
    "three",
    "webgl",
    "embodied",
    "shipshit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipshitgames/shipshit.games.git",
    "directory": "packages/engine"
  }
}
