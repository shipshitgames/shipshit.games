{
  "name": "@shipshitgames/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Ship Shit Games command-line entrypoint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipshitgames/shipshit.games.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "shipshitgames": "./src/cli.js",
    "ssg": "./src/cli.js"
  },
  "files": [
    "src",
    "templates",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node ./src/cli.js --version",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "e2e": "bun test e2e",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --removeRange && bun install"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  }
}
