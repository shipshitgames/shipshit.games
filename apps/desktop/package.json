{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Ship Shit Games — Studio cockpit (Electron + Vite + React generator hub)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5273 && electron .",
    "dev": "concurrently -k -n renderer,electron -c magenta,cyan \"bun run dev:renderer\" \"bun run dev:electron\"",
    "build:renderer": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --target minor && bun install"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "9.1.2",
    "electron": "33.4.11",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "wait-on": "8.0.3"
  }
}
