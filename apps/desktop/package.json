{
  "name": "@shipshitgames/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ship Shit Games — Studio cockpit (Electron + Vite + React generator hub)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipshitgames/shipshit.games.git",
    "directory": "apps/desktop"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5273 && electron .",
    "dev": "concurrently -k -n renderer,electron -c magenta,cyan \"bun run dev:renderer\" \"bun run dev:electron\"",
    "build:renderer": "vite build",
    "build": "vite build",
    "package:mac": "bun run build && electron-builder --mac dmg --publish never",
    "preview": "vite preview",
    "start": "electron .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --removeRange && bun install"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "build": {
    "appId": "games.shipshit.studio",
    "productName": "Ship Shit Games Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "electron": "42.3.3",
    "electron-builder": "26.15.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wait-on": "9.0.10"
  }
}
