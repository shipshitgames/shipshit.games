{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Ship Shit Games — Studio cockpit (Electron + Vite + React generator hub)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5273 && electron .",
    "dev": "concurrently -k -n renderer,electron -c magenta,cyan \"bun run dev:renderer\" \"bun run dev:electron\"",
    "build:renderer": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "deps:update": "bunx npm-check-updates -u --cooldown 3h --removeRange && bun install"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "electron": "42.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wait-on": "9.0.10"
  }
}
