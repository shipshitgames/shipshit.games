NEXT_PUBLIC_SITE_URL=https://shipshit.games
NEXT_PUBLIC_APP_URL=https://app.shipshit.games
# Optional shared Deadrot asset origin. When set, asset-index-backed pages
# resolve package-relative assets from this CDN and keep public/ copies as local fallback.
NEXT_PUBLIC_ASSET_BASE_URL=
ASSET_BASE_URL=
NEXT_PUBLIC_SUBSTACK_URL=
NEXT_PUBLIC_FORMSPREE_ID=

STRIPE_SECRET_KEY=
STRIPE_STUDIO_PASS_PRICE_ID=
STRIPE_STUDIO_PASS_FOUNDER_COUPON_ID=STUDIOFOUNDER20

# PostHog product analytics + feature flags (public client key — safe to expose).
# Analytics only initializes in production (VERCEL is set); leave unset for local
# dev/e2e to keep it a no-op. Set both in the Vercel project env for production.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
