generator client {
  provider      = "prisma-client-js"
  // In-app output: bun's nested node_modules store breaks Next's standalone
  // file tracing, so the client (and its engines) must live inside the app.
  output        = "../generated/client"
  // native: local dev (darwin) / Vercel build (rhel); the rest: Docker runners.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Generated Asset Lab sprite. New images are written to object storage when
/// configured; `image` stays nullable for local-dev fallback and old rows.
model Asset {
  id          String   @id @default(uuid())
  subject     String
  description String?
  fullPrompt  String
  style       String?
  pose        String?
  sheetPoses  String[] @default([])
  gameSlug    String?
  game        String?
  model       String
  image       Bytes?
  storageKey  String?
  imageUrl    String?
  mediaType   String   @default("image/png")
  byteSize    Int?
  ownerId     String?
  parentId    String?
  parent      Asset?   @relation("AssetSlices", fields: [parentId], references: [id], onDelete: SetNull)
  slices      Asset[]  @relation("AssetSlices")
  sliceIndex  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([gameSlug])
  @@index([parentId])
  @@index([storageKey])
  @@unique([parentId, sliceIndex])
}

/// Mirror of Clerk users, maintained by the Clerk webhook.
model User {
  id        String    @id // Clerk user id
  email     String?
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// Audit log of every verified webhook delivery (stripe | clerk | github).
model WebhookEvent {
  id             String    @id @default(uuid())
  source         String
  externalId     String?
  type           String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  eventCreatedAt DateTime?
  lastAttemptAt  DateTime?
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([source, type])
  @@index([source, status])
  @@index([receivedAt(sort: Desc)])
}

/// Canonical durable Studio Pass state. Stripe webhooks are the only writer;
/// app surfaces read this through the authenticated billing API.
model StudioPassSubscription {
  userId               String   @id
  stripeCustomerId     String
  stripeSubscriptionId String   @unique
  stripePriceId        String?
  status               String
  active               Boolean
  currentPeriodEnd     DateTime?
  checkoutSessionId    String?
  claimedAt            DateTime?
  stripeEventCreatedAt BigInt
  stripeEventRank      Int
  stripeEventId        String
  skoolInviteSentAt    DateTime?
  accessEmailSentAt    DateTime?
  fulfillmentError     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([active, status])
}

/// Canonical durable one-time Skills Pro purchase and refund state.
model SkillsProPurchase {
  userId               String   @id
  active               Boolean  @default(true)
  stripeCustomerId     String?
  stripePaymentIntentId String?  @unique
  checkoutSessionId    String?  @unique
  purchasedAt          DateTime
  stripeEventCreatedAt BigInt
  stripeEventRank      Int
  stripeEventId        String
  accessEmailSentAt    DateTime?
  fulfillmentError     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([active])
}

/// Durable audit trail for signed member-content grants and denials.
model ContentAccessEvent {
  id         String   @id @default(uuid())
  userId     String
  resource   String
  resourceId String?
  outcome    String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([resource, resourceId, createdAt(sort: Desc)])
}

/// Commits ingested from GitHub push webhooks; feeds /v1/stats/commits.
model Commit {
  id          String   @id @default(uuid())
  repo        String
  sha         String
  authorLogin String?
  authorEmail String?
  message     String
  committedAt DateTime
  receivedAt  DateTime @default(now())

  @@unique([repo, sha])
  @@index([repo, committedAt(sort: Desc)])
  @@index([authorLogin])
}
