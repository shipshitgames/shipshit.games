DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shipshit_api
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3002,https://app.shipshit.games

CLERK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
REPLICATE_API_TOKEN=
SERVICE_NAME=api.shipshit.games
NEXT_PUBLIC_APP_URL=https://app.shipshit.games

# Optional fulfillment channels. The event id is sent as an idempotency key.
SKOOL_FULFILLMENT_ENABLED=false
SKOOL_INVITE_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_URL=
RESEND_API_KEY=
ACCESS_EMAIL_FROM=

# Optional S3-compatible Asset Lab object storage.
# Leave ASSET_STORAGE_BUCKET empty for local dev DB-byte fallback.
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_REGION=us-east-1
ASSET_STORAGE_ENDPOINT=
ASSET_STORAGE_PREFIX=asset-lab
ASSET_STORAGE_PUBLIC_BASE_URL=https://assets.shipshit.games
ASSET_STORAGE_FORCE_PATH_STYLE=
