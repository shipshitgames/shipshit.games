  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "partykit": "^0.0.114",
    "tailwindcss": "^4.1.8",
    "typescript": "5.8.3",
    "vite": "^5.4.10"
  }
}
