{
  "name": "shipshitgames",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "bun run check:design && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e": "turbo run e2e",
    "ci": "bun run ci:scaffold && bun run ci:engine && bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "ci:engine": "bun run --cwd packages/engine build && bun run --cwd packages/engine typecheck",
    "ci:scaffold": "bun scripts/scaffold-smoke.mjs",
    "check:design": "bun packages/assetgen/src/cli.ts check-design",
    "release": "bun scripts/release.mjs",
    "release:run": "bun scripts/release.mjs --execute",
    "deps:update": "bunx npm-check-updates -u --deep --cooldown 3h --removeRange && bun install"
  },
  "devDependencies": {
    "turbo": "2.9.16",
    "typescript": "6.0.3"
  }
}
